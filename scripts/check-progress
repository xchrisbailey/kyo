#!/usr/bin/env python3
"""Atomic live status for scripts/check. Final text records remain the gate."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import time


def identity(pid):
    try:
        return subprocess.check_output(['ps', '-o', 'lstart=', '-p', str(pid)], text=True).strip()
    except subprocess.CalledProcessError:
        return ''


def write(path, data):
    temporary = path.with_name(f'{path.name}.{os.getpid()}.tmp')
    temporary.write_text(json.dumps(data) + '\n')
    os.replace(temporary, path)


def status(directory, sha):
    path = directory / f'{sha}.json'
    if not path.exists():
        return dict(commit=sha, state='absent', outcome=None)
    data = json.loads(path.read_text())
    data['elapsed_seconds'] = round(data.get('finished_at', time.time()) - data['started_at'])
    if data['state'] != 'completed' and identity(data['pid']) != data['process_start']:
        data['state'], data['outcome'] = 'interrupted', None
    if data['state'] == 'completed':
        record = directory / f'{sha}.txt'
        if not record.exists() or f"RESULT: {data['outcome']}\n" not in record.read_text():
            data['state'], data['outcome'] = 'incomplete', None
    log = Path(data['log']) if data.get('log') else None
    if log and log.exists():
        lines = log.read_text(errors='replace').splitlines()
        # The controller streams only summaries; its native log holds live test lines.
        native_logs = [line.removeprefix('scripts/test: full log: ') for line in lines
                       if line.startswith('scripts/test: full log: ')]
        if native_logs and Path(native_logs[-1]).is_file():
            data['native_log'] = native_logs[-1]
            lines += Path(native_logs[-1]).read_text(errors='replace').splitlines()
        useful = [line for line in lines if any(token in line for token in ('Test Case ', 'Executed ', 'Test Suite ', 'scripts/test:', ' error:', 'Test run with ', '✔', '✘'))]
        data['last_test_line'] = useful[-1] if useful else (lines[-1] if lines else None)
        if any('waiting for the UI suite lock' in line for line in lines) and not any('got the UI suite lock' in line for line in lines):
            data['state'] = 'queued' if data['state'] == 'running' else data['state']
    return data


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['start', 'update', 'finish', 'status', 'watch'])
    parser.add_argument('sha')
    parser.add_argument('--pid', type=int)
    parser.add_argument('--phase')
    parser.add_argument('--log')
    parser.add_argument('--outcome', choices=['PASS', 'FAIL', 'PARTIAL'])
    parser.add_argument('--seconds', type=int, default=60)
    args = parser.parse_args()
    directory = Path(os.environ.get('TMPDIR', '/tmp')) / 'kyo-check'
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / f'{args.sha}.json'
    if args.action in ('status', 'watch'):
        if not 0 <= args.seconds <= 60:
            parser.error('--seconds must be between 0 and 60')
        deadline = time.monotonic() + (args.seconds if args.action == 'watch' else 0)
        previous = None
        while True:
            data = status(directory, args.sha)
            rendered = json.dumps(data, sort_keys=True)
            # Emit state/phase/last-line changes, not an elapsed-time heartbeat.
            signature = (data['state'], data.get('phase'), data.get('last_test_line'), data.get('outcome'))
            if signature != previous:
                print(rendered, flush=True)
                previous = signature
            if data['state'] not in ('running', 'queued') or time.monotonic() >= deadline:
                return 0
            time.sleep(min(1, max(0, deadline - time.monotonic())))
    if not args.pid or not identity(args.pid):
        parser.error('mutation requires a live owner --pid')
    if args.action == 'start':
        data = dict(commit=args.sha, pid=args.pid, process_start=identity(args.pid), started_at=time.time(),
                    state='running', phase='starting', log=None, outcome=None)
    else:
        data = json.loads(path.read_text())
        if data['pid'] != args.pid or data['process_start'] != identity(args.pid):
            parser.error('run belongs to another process')
        if args.action == 'update':
            data.update(state='running', phase=args.phase, log=args.log)
        else:
            if not args.outcome:
                parser.error('finish requires --outcome')
            data.update(state='completed', finished_at=time.time(), outcome=args.outcome)
    write(path, data)
    return 0


if __name__ == '__main__':
    sys.exit(main())
