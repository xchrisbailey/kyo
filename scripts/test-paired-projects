#!/usr/bin/env bash
# Sourced only by scripts/test, which owns the global UI lock and all cleanup.
# Each phase uses public UI and real, freshly installed stores on an owned pair.
paired_run() {
  local phase="$1"
  shift
  log="$log_dir/$run_id-paired-$phase.log"
  echo "scripts/test: paired $phase; full log: $log"
  "$@" >"$log" 2>&1 &
  xcodebuild_pid=$!
  local status=0 failed_seconds=0 passed_seconds=0 stopped_failure_helper=0
  while kill -0 "$xcodebuild_pid" 2>/dev/null; do
    if grep -qE "^Test Suite '(All tests|Selected tests)' failed" "$log"; then
      failed_seconds=$((failed_seconds + 1))
      if [[ $failed_seconds -ge 20 ]] \
        && pkill -TERM -P "$xcodebuild_pid" -f 'simctl diagnose' 2>/dev/null; then
        if [[ $stopped_failure_helper -eq 0 ]]; then
          echo "scripts/test: stopped owned simulator diagnostics helper after failed suite; allowing result finalization" >&2
          stopped_failure_helper=1
        fi
      fi
      if [[ $failed_seconds -ge 120 ]]; then
        echo "scripts/test: owned xcodebuild did not finalize within 120s after failure; stopping it, result bundle may be incomplete" >&2
        stop_xcodebuild
        status=65
        break
      fi
    elif grep -qE "^Test Suite '(All tests|Selected tests)' passed" "$log"; then
      passed_seconds=$((passed_seconds + 1))
      if [[ $passed_seconds -ge 20 ]]; then
        pkill -TERM -P "$xcodebuild_pid" -f 'simctl diagnose' 2>/dev/null || true
      fi
    fi
    sleep 1
  done
  wait "$xcodebuild_pid" || status=$?
  xcodebuild_pid=""
  grep -E "Test Suite '.*' (passed|failed)|Executed [0-9]+ tests?, with|: error:|Test Case .* (failed|skipped)|Testing failed:|Result bundle|\*\*.*(SUCCEEDED|FAILED).*\*\*" "$log" || true
  [[ $status -eq 0 ]] || return "$status"
}

paired_phase() {
  local phase="$1" target_scheme="$2" destination="$3" test_name="$4" data="$5"
  local phase_status=0
  TEST_RUNNER_KYO_PAIRED_PROJECTS=1 \
  TEST_RUNNER_KYO_PAIRED_PROJECTS_TOKEN="$paired_token" \
  TEST_RUNNER_KYO_PAIRED_PROJECTS_PHASE="$phase" \
    paired_run "$phase" xcodebuild -project "$project" -scheme "$target_scheme" \
      -destination "id=$destination" -derivedDataPath "$data" \
      -parallel-testing-enabled NO -maximum-concurrent-test-simulator-destinations 1 \
      -resultBundlePath "$log_dir/$run_id-paired-$phase.xcresult" \
      "-only-testing:$target_scheme/PairedProjectsSyncUITests/$test_name" test-without-building || phase_status=$?
  local result="$log_dir/$run_id-paired-$phase.xcresult"
  if [[ -d "$result" ]]; then
    xcrun xcresulttool export attachments --path "$result" \
      --output-path "$log_dir/$run_id-paired-$phase-attachments" \
      || echo "scripts/test: attachment export unavailable; retained result directory may be incomplete: $result" >&2
  fi
  [[ $phase_status -eq 0 ]] || return "$phase_status"
  # Successful xcodebuild with a skipped or missing test is not paired evidence.
  local passed="Test Case '-[$target_scheme.PairedProjectsSyncUITests $test_name]' passed"
  grep -Fq "$passed" "$log" || { echo "scripts/test: missing executed phase $phase" >&2; return 1; }
  grep -qE 'Executed 1 test, with 0 failures' "$log" || return 1
  if grep -qE 'Test Case .* skipped|Executed .* skipped' "$log"; then
    echo "scripts/test: skipped paired phase $phase" >&2
    return 1
  fi
}

paired_token="$(uuidgen | cut -c1-8)"
watch_runtime="$(pick_runtime watchOS 27.0)"
watch_type="$(xcrun simctl list devicetypes | grep -E '^Apple Watch Series [0-9]+ \(46mm\)' \
  | sort -V | tail -n 1 | sed -E 's/.*\((com\.apple[^)]*)\)$/\1/')"
udid="$(xcrun simctl create "$run_id-phone" "$device_type" "$runtime")"
watch_udid="$(xcrun simctl create "$run_id-watch" "$watch_type" "$watch_runtime")"
pair_id="$(xcrun simctl pair "$watch_udid" "$udid")"
if xcrun simctl pair_activate "$pair_id"; then
  :
else
  activation_status=$?
  [[ $activation_status -eq 37 ]] || exit "$activation_status"
  # Pair creation can activate it automatically. Accept only that observed state.
  xcrun simctl list pairs --json | python3 -c '
import json, sys
pair = json.load(sys.stdin)["pairs"].get(sys.argv[1], {})
valid = pair.get("state", "").startswith("(active,") and pair.get("phone", {}).get("udid") == sys.argv[2] and pair.get("watch", {}).get("udid") == sys.argv[3]
sys.exit(0 if valid else 1)
' "$pair_id" "$udid" "$watch_udid"
fi
echo "scripts/test: owned paired devices phone=$udid watch=$watch_udid pair=$pair_id token=$paired_token"
phone_data="$work/PhoneDerivedData"
watch_data="$work/WatchDerivedData"
# Build before booting either simulator; retain simulator code signing.
paired_run phone-build xcodebuild -project "$project" -scheme KyoUITests \
  -destination "id=$udid" -derivedDataPath "$phone_data" build-for-testing
paired_run watch-build xcodebuild -project "$project" -scheme KyoWatchUITests \
  -destination "id=$watch_udid" -derivedDataPath "$watch_data" build-for-testing
phone_app="$phone_data/Build/Products/Debug-iphonesimulator/Kyo.app"
watch_app="$watch_data/Build/Products/Debug-watchsimulator/KyoWatch.app"
for product in "$phone_app" "$watch_app"; do
  [[ -d "$product" ]] || { echo "scripts/test: missing product $product" >&2; exit 1; }
done
phone_bundle="$(/usr/libexec/PlistBuddy -c 'Print CFBundleIdentifier' "$phone_app/Info.plist")"
watch_bundle="$(/usr/libexec/PlistBuddy -c 'Print CFBundleIdentifier' "$watch_app/Info.plist")"
[[ "$phone_bundle" == computer.srcery.kyo && "$watch_bundle" == computer.srcery.kyo.watchkitapp ]] || exit 1
xcrun simctl bootstatus "$udid" -b
xcrun simctl bootstatus "$watch_udid" -b
xcrun simctl install "$udid" "$phone_app"
xcrun simctl install "$watch_udid" "$watch_app"
xcrun simctl launch "$udid" "$phone_bundle"
xcrun simctl launch "$watch_udid" "$watch_bundle"
paired_phase phone-seed KyoUITests "$udid" testPhoneSeed "$phone_data"
# The phone XCTest ends its app. Reopen the real app after installation recognition
# settles, so activation republishes the saved catalog and it stays alive for Watch.
xcrun simctl launch --terminate-running-process "$udid" "$phone_bundle" \
  | tee "$log_dir/$run_id-paired-handoff-original.log"
paired_phase watch-original KyoWatchUITests "$watch_udid" testWatchObserveOriginal "$watch_data"
paired_phase phone-off KyoUITests "$udid" testPhoneDisableProjects "$phone_data"
xcrun simctl launch --terminate-running-process "$udid" "$phone_bundle" \
  | tee "$log_dir/$run_id-paired-handoff-off.log"
paired_phase watch-off KyoWatchUITests "$watch_udid" testWatchObserveProjectsDisabled "$watch_data"
paired_phase phone-on KyoUITests "$udid" testPhoneEnableProjects "$phone_data"
xcrun simctl launch --terminate-running-process "$udid" "$phone_bundle" \
  | tee "$log_dir/$run_id-paired-handoff-on.log"
paired_phase watch-on KyoWatchUITests "$watch_udid" testWatchObserveProjectsEnabledAgain "$watch_data"
paired_phase phone-rename KyoUITests "$udid" testPhoneRename "$phone_data"
xcrun simctl launch --terminate-running-process "$udid" "$phone_bundle" \
  | tee "$log_dir/$run_id-paired-handoff-renamed.log"
paired_phase watch-command KyoWatchUITests "$watch_udid" testWatchObserveRenameAndComplete "$watch_data"
echo "scripts/test: supported Projects Simulator coverage verified; 8 executed phases, no skips; token=$paired_token"
echo "scripts/test: physical-device round-trip PENDING: queued Watch command receipt and authoritative reconciliation are not covered by Simulator."
