#!/usr/bin/env python3
"""Hold a kernel-owned per-commit lock across exec; dead owners need no reclamation."""
import fcntl
import os
from pathlib import Path
import sys

path = Path(sys.argv[1])
path.parent.mkdir(parents=True, exist_ok=True)
fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
try:
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    print('scripts/check: another run owns this commit; use --status or --watch', file=sys.stderr)
    sys.exit(2)
os.dup2(fd, 9)
if fd != 9:
    os.close(fd)
os.set_inheritable(9, True)
os.environ['KYO_CHECK_LOCK_OWNER'] = str(os.getpid())
os.execv(sys.argv[2], sys.argv[2:])
